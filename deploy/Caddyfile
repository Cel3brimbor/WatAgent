{
	# No host-accessible Caddy management endpoint in host-network mode.
	admin off
}

{$APP_ADDRESS} {
	root * {$STATIC_ROOT:/srv}
	encode zstd gzip
	header {
		-Server
		Strict-Transport-Security "max-age=63072000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=(), usb=()"
		Cross-Origin-Opener-Policy same-origin
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"
	}

	@api path /api /api/*
	handle @api {
		reverse_proxy {$API_UPSTREAM:127.0.0.1:4000} {
			# This deployment receives visitors directly, without Vercel/CDN trust.
			# Never accept a visitor-supplied proxy secret or claimed client IP.
			header_up -X-Watagent-Proxy-Secret
			header_up -X-Watagent-Client-Ip
			header_up -Forwarded
			header_up X-Real-IP {remote_host}
			flush_interval -1
		}
	}

	handle /healthz {
		respond "ok" 200
	}

	handle /_next/static/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		header Cache-Control "no-cache"
		# Next static exports have one directory/index.html per route.
		# Missing routes must stay 404; do not turn API errors into the app shell.
		file_server
	}

	handle_errors {
		header Cache-Control "no-store"
		rewrite * /404.html
		file_server
	}
}
